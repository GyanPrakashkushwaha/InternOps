\usepackage[unicode, draft=false]{hyperref}
\definecolor{linkcolour}{rgb}{0,0.2,0.6}
\hypersetup{colorlinks,breaklinks,urlcolor=linkcolour,linkcolor=linkcolour}
\usepackage{fontawesome5}

% Custom Environments
\newenvironment{jobshort}[2]
    {
    \begin{tabularx}{\linewidth}{@{}l X r@{}}
    \textbf{#1} & \hfill &  #2 \\[2pt]
    \end{tabularx}
    }
    {}

\newenvironment{joblong}[2]
    {
    \begin{tabularx}{\linewidth}{@{}X r@{}}
    \textbf{#1} & #2 \\[2pt]
    \end{tabularx}
    \begin{minipage}[t]{\linewidth}
    \begin{itemize}[nosep,after=\strut, leftmargin=1em, itemsep=1pt,label=--]
    }
    {
    \end{itemize}
    \end{minipage}    
    }

\begin{document}
\pagestyle{empty} 

%----------------------------------------------------------------------------------------
%	HEADER
%----------------------------------------------------------------------------------------
\begin{tabularx}{\linewidth}{@{} C @{}}
\Huge{ {{ full_name }} } \\[5pt]
\href{ {{ github_url }} }{\raisebox{-0.05\height}\faGithub\ GitHub} \ $|$ \ 
\href{ {{ linkedin_url }} }{\raisebox{-0.05\height}\faLinkedin\ LinkedIn} \ $|$ \ 
{% if kaggle_url %}
\href{ {{ kaggle_url }} }{\raisebox{-0.05\height}\faGlobe\ Kaggle} \ $|$ \ 
{% endif %}
\href{mailto:{{ email }} }{\raisebox{-0.05\height}\faEnvelope \ Email} \ $|$ \ 
\href{tel:{{ phone }} }{\raisebox{-0.05\height}\faMobile \ {{ phone }} } \\
\end{tabularx}

%----------------------------------------------------------------------------------------
%	SUMMARY
%----------------------------------------------------------------------------------------
\section{Summary}
{{ summary | escape_tex }}

%----------------------------------------------------------------------------------------
%	EDUCATION
%----------------------------------------------------------------------------------------
\section{Education}
{% for edu in education %}
\begin{tabularx}{\linewidth}{@{}X r@{}}	
\textbf{ {{ edu.institution }} } & {{ edu.location }} \\
\textit{ {{ edu.degree }} } & \textit{ {{ edu.dates }} } \\
\end{tabularx}
{% endfor %}

%----------------------------------------------------------------------------------------
%	PROJECTS
%----------------------------------------------------------------------------------------
\section{Projects}

{% for project in projects %}
\begin{joblong}{ {{ project.name }} \textmd{$|$ {{ project.tech_stack | escape_tex }} }}{\href{ {{ project.url }} }{Repo Link}}
{% for bullet in project.bullets %}
\item {{ bullet | escape_tex }}
{% endfor %}
\end{joblong}
{% endfor %}

%----------------------------------------------------------------------------------------
%	SKILLS
%----------------------------------------------------------------------------------------
\section{Skills}
\begin{tabularx}{\linewidth}{@{}l X@{}}
{% for category, skills_list in skills.items() %}
{{ category | escape_tex }} & \normalsize{ {{ skills_list | escape_tex }} } \\
{% endfor %}
\end{tabularx}

%----------------------------------------------------------------------------------------
%	ACHIEVEMENTS
%----------------------------------------------------------------------------------------
\section{Achievements}
\begin{itemize}[leftmargin=*]
{% for achievement in achievements %}
  \item {{ achievement | escape_tex }}
{% endfor %}
\end{itemize}

\end{document}